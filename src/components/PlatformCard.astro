---
interface Props {
  name: string;
  handle: string;
  accent: string;
  descEn: string;
  descCn: string;
  ctaEn: string;
  ctaCn: string;
  href?: string;
}

const { name, handle, accent, descEn, descCn, ctaEn, ctaCn, href = '#' } = Astro.props;
---

<a href={href} class="platform-card">
  <div class="platform-card-accent" style={`background: ${accent}`}></div>
  <div class="platform-name">{name}</div>
  <div class="platform-handle">{handle}</div>
  <p class="platform-desc" data-en={descEn} data-cn={descCn}>{descEn}</p>
  <div class="platform-cta">
    <span data-en={ctaEn} data-cn={ctaCn}>{ctaEn}</span>
    <span class="platform-arrow">→</span>
  </div>
</a>

<style>
  .platform-card {
    background: var(--cream);
    border: 1px solid var(--sand);
    border-radius: 12px;
    padding: 28px 24px;
    text-decoration: none;
    color: inherit;
    display: block;
    transition: box-shadow 200ms, transform 200ms, background 200ms;
    position: relative;
    overflow: hidden;
  }

  .platform-card:hover {
    box-shadow: 0 6px 24px rgba(45, 43, 40, 0.11);
    transform: translateY(-3px);
    background: var(--linen);
  }

  .platform-card-accent {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
  }

  .platform-name {
    font-size: 16px;
    font-weight: 600;
    color: var(--deep);
    margin-bottom: 4px;
  }

  .platform-handle {
    font-size: 12px;
    color: var(--warm-gray);
    margin-bottom: 12px;
  }

  .platform-desc {
    font-size: 13px;
    font-weight: 300;
    color: var(--dim);
    line-height: 1.7;
    margin-bottom: 20px;
  }

  :global(.lang-cn) .platform-desc {
    font-family: var(--font-cn-body);
  }

  .platform-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 500;
    color: var(--terra);
  }

  .platform-arrow {
    display: inline-block;
    transition: transform 150ms;
  }

  .platform-card:hover .platform-arrow {
    transform: translateX(3px);
  }
</style>
