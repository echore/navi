---
---

<div class="quote-band">
  <div class="quote-inner">
    <div class="quote-line"></div>
    <div class="quote-text" id="quote-text">
      "AI isn't for doing what you can't.<br />It's for skipping what isn't worth your time."
    </div>
  </div>
</div>

<style>
  .quote-band {
    background: var(--parchment);
    border-top: 1px solid #DDD8CE;
    border-bottom: 1px solid #DDD8CE;
    padding: 64px 40px;
  }

  .quote-inner {
    max-width: 680px;
    margin: 0 auto;
    text-align: center;
  }

  .quote-line {
    width: 36px;
    height: 3px;
    background: var(--terra);
    border-radius: 2px;
    margin: 0 auto 28px;
  }

  .quote-text {
    font-family: var(--font-display);
    font-size: 24px;
    font-style: italic;
    line-height: 1.45;
    color: var(--deep);
    letter-spacing: -0.01em;
  }

  :global(.lang-cn) .quote-text {
    font-family: var(--font-cn-display);
    font-style: normal;
    font-size: 19px;
    line-height: 1.85;
  }
</style>
