---
---

<nav>
  <a href="/" class="nav-logo">
    <img src="/assets/logo-icon.png" alt="" class="nav-logo-icon" />
    <span class="nav-logo-word">Navi</span>
  </a>

  <ul class="nav-links">
    <li><a href="/#posts" id="nav-posts">Posts</a></li>
    <li><a href="/#platforms" id="nav-find">Find me</a></li>
    <li><a href="/#newsletter" id="nav-nl">Newsletter</a></li>
  </ul>

  <div class="nav-right">
    <div class="lang-toggle">
      <button class="lang-btn active" id="btn-en" onclick="setLang('en')">EN</button>
      <button class="lang-btn" id="btn-cn" onclick="setLang('cn')">中文</button>
    </div>
    <a href="/#platforms" class="nav-cta" id="nav-cta">Find my socials</a>
  </div>
</nav>

<style>
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 40px;
    height: 58px;
    border-bottom: 0.5px solid rgba(44, 40, 32, 0.10);
    background: transparent;
    flex-shrink: 0;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
  }

  .nav-logo-icon {
    width: 26px;
    height: 26px;
    border-radius: 7px;
    object-fit: cover;
  }

  .nav-logo-word {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 15px;
    color: var(--deep);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 24px;
    list-style: none;
  }

  .nav-links a {
    font-size: 13px;
    font-weight: 400;
    color: var(--warm-gray);
    text-decoration: none;
    transition: color 150ms;
  }

  .nav-links a:hover {
    color: var(--deep);
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .lang-toggle {
    display: flex;
    align-items: center;
    background: rgba(44, 40, 32, 0.07);
    border-radius: 999px;
    padding: 3px;
    gap: 1px;
  }

  .lang-btn {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    padding: 4px 11px;
    border-radius: 999px;
    border: none;
    cursor: pointer;
    background: transparent;
    color: var(--warm-gray);
    transition: all 150ms;
    letter-spacing: 0.03em;
  }

  .lang-btn.active {
    background: var(--deep);
    color: var(--canvas);
  }

  .nav-cta {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 500;
    background: var(--terra);
    color: #FAF9F6;
    border: none;
    border-radius: 999px;
    padding: 8px 20px;
    cursor: pointer;
    transition: background 150ms;
  }

  .nav-cta:hover {
    background: var(--terra-dk);
  }

  @media (max-width: 768px) {
    nav {
      padding: 0 20px;
    }
    .nav-links {
      display: none;
    }
  }
</style>
