---
---

<nav>
  <a href="/" class="nav-logo">
    <img src="/assets/logo-icon.png" alt="" class="nav-logo-icon" />
    <span class="nav-logo-word">Navi</span>
  </a>

  <ul class="nav-links">
    <li><a href="/#posts" id="nav-posts">Posts</a></li>
    <li><a href="/#platforms" id="nav-find">Find me</a></li>
    <li><a href="/#newsletter" id="nav-nl">Newsletter</a></li>
  </ul>

  <div class="nav-right">
    <div class="lang-toggle" id="lang-toggle-wrap" style="position:relative">
      <button class="lang-btn active" id="btn-en" onclick="setLang('en')">EN</button>
      <button class="lang-btn" id="btn-cn" onclick="setLang('cn')">中文</button>
      <div class="lang-hint" id="lang-hint">
        <span class="lang-hint-arrow">👆</span>
        点这里切换中文
      </div>
    </div>
    <a href="/#platforms" class="nav-cta" id="nav-cta">Find my socials</a>
    <button class="hamburger" id="hamburger" aria-label="Open menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<!-- Mobile dropdown menu -->
<div class="mobile-menu" id="mobile-menu" aria-hidden="true">
  <a href="/#posts" class="mobile-link" id="m-posts">Posts</a>
  <a href="/#platforms" class="mobile-link" id="m-find">Find me</a>
  <a href="/#newsletter" class="mobile-link" id="m-nl">Newsletter</a>
</div>

<style>
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 40px;
    height: 58px;
    border-bottom: 0.5px solid rgba(44, 40, 32, 0.10);
    background: transparent;
    flex-shrink: 0;
    position: relative;
    z-index: 100;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
  }

  .nav-logo-icon {
    width: 26px;
    height: 26px;
    border-radius: 7px;
    object-fit: cover;
  }

  .nav-logo-word {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 15px;
    color: var(--deep);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 24px;
    list-style: none;
  }

  .nav-links a {
    font-size: 13px;
    font-weight: 400;
    color: var(--warm-gray);
    text-decoration: none;
    transition: color 150ms;
  }

  .nav-links a:hover {
    color: var(--deep);
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .lang-toggle {
    display: flex;
    align-items: center;
    background: rgba(44, 40, 32, 0.07);
    border-radius: 999px;
    padding: 3px;
    gap: 1px;
    position: relative;
  }

  .lang-hint {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    background: var(--deep);
    color: var(--canvas);
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 400;
    white-space: nowrap;
    padding: 7px 13px;
    border-radius: 10px;
    pointer-events: none;
    display: flex;
    align-items: center;
    gap: 6px;
    box-shadow: 0 4px 16px rgba(44, 40, 32, 0.18);
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 0.3s ease, transform 0.3s ease;
    z-index: 200;
  }

  /* The little triangle pointing up */
  .lang-hint::before {
    content: '';
    position: absolute;
    top: -6px;
    right: 18px;
    border-left: 6px solid transparent;
    border-right: 6px solid transparent;
    border-bottom: 6px solid var(--deep);
  }

  .lang-hint.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .lang-hint-arrow {
    font-size: 14px;
    line-height: 1;
  }

  .lang-btn {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    padding: 4px 11px;
    border-radius: 999px;
    border: none;
    cursor: pointer;
    background: transparent;
    color: var(--warm-gray);
    transition: all 150ms;
    letter-spacing: 0.03em;
  }

  .lang-btn.active {
    background: var(--deep);
    color: var(--canvas);
  }

  .nav-cta {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 500;
    background: var(--terra);
    color: #FAF9F6;
    border: none;
    border-radius: 999px;
    padding: 8px 20px;
    cursor: pointer;
    transition: background 150ms;
  }

  .nav-cta:hover {
    background: var(--terra-dk);
  }

  /* Hamburger button — hidden on desktop/tablet */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 36px;
    height: 36px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
  }

  .hamburger span {
    display: block;
    width: 100%;
    height: 1.5px;
    background: var(--deep);
    border-radius: 2px;
    transition: transform 200ms, opacity 200ms;
  }

  .hamburger.open span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
  .hamburger.open span:nth-child(2) { opacity: 0; }
  .hamburger.open span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

  /* Mobile dropdown */
  .mobile-menu {
    display: none;
    flex-direction: column;
    background: var(--canvas);
    border-bottom: 0.5px solid rgba(44, 40, 32, 0.10);
    padding: 8px 20px 16px;
    position: relative;
    z-index: 99;
  }

  .mobile-menu.open {
    display: flex;
  }

  .mobile-link {
    font-size: 15px;
    font-weight: 400;
    color: var(--espresso);
    text-decoration: none;
    padding: 10px 0;
    border-bottom: 0.5px solid rgba(44, 40, 32, 0.06);
    transition: color 150ms;
  }

  .mobile-link:last-child {
    border-bottom: none;
  }

  .mobile-link:hover {
    color: var(--terra);
  }

  @media (max-width: 639px) {
    nav {
      padding: 0 20px;
    }
    .nav-links {
      display: none;
    }
    .nav-cta {
      display: none;
    }
    .hamburger {
      display: flex;
    }
  }
</style>

<script is:inline>
  (function () {
    // --- Language hint bubble (demo: always show) ---
    var hint = document.getElementById('lang-hint');
    var toggle = document.getElementById('lang-toggle-wrap');

    if (hint) {
      // Show after a short delay so it doesn't flash on load
      setTimeout(function () { hint.classList.add('visible'); }, 1200);

      // Auto-hide after 4 seconds
      setTimeout(function () {
        hint.classList.remove('visible');
      }, 5200);

      // Also hide immediately when user clicks the toggle
      if (toggle) {
        toggle.addEventListener('click', function () {
          hint.classList.remove('visible');
        });
      }
    }
  })();

  (function () {
    var btn = document.getElementById('hamburger');
    var menu = document.getElementById('mobile-menu');
    if (!btn || !menu) return;

    btn.addEventListener('click', function () {
      var open = menu.classList.toggle('open');
      btn.classList.toggle('open', open);
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      menu.setAttribute('aria-hidden', open ? 'false' : 'true');
    });

    // Close menu when a link is tapped
    menu.querySelectorAll('.mobile-link').forEach(function (link) {
      link.addEventListener('click', function () {
        menu.classList.remove('open');
        btn.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
        menu.setAttribute('aria-hidden', 'true');
      });
    });
  })();
</script>
