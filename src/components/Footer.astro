---
---

<footer>
  <div class="footer-inner">
    <div class="footer-brand">
      <span class="footer-brand-name">Yachen Li</span>
    </div>
    <span class="footer-tagline" id="footer-tagline">© 2026 Yachen Li</span>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--sand);
    background: var(--canvas);
  }

  .footer-inner {
    max-width: 1080px;
    margin: 0 auto;
    padding: 36px 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .footer-brand-name {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 14px;
    color: var(--deep);
  }

  .footer-tagline {
    font-size: 11px;
    color: var(--faint);
  }

  @media (max-width: 768px) {
    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
  }
</style>
