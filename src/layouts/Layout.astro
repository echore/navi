---
interface Props {
  title?: string;
  description?: string;
  lang?: 'en' | 'zh';
}

const {
  title = 'Yachen Li',
  description = 'Writing by Yachen Li on AI tools, business, and how I make decisions.',
  lang = 'en',
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- Fonts (preconnect first for performance) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&family=Noto+Serif+SC:wght@400;500&family=Noto+Sans+SC:wght@300;400&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/png" href="/assets/logo-icon.png" />
  </head>
  <body>
    <slot />

  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
