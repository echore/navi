---
import Layout from './Layout.astro';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  lang: 'en' | 'zh';
  tags: string[];
  date: Date;
  readTime: number;
}

const { title, lang, tags, date, readTime } = Astro.props;

const dateStr = date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
const primaryTag = tags[0] ?? 'Notes';
const tagColor = primaryTag === 'AI' ? 'var(--terra)' : 'var(--sage)';
---

<Layout title={`${title} — Stay Curious`} description={title} lang={lang}>
  <NavBar />

  <main class="post-main">
    <article class="post-article">
      <header class="post-header">
        <div class="post-tag" style={`color: ${tagColor}`}>{primaryTag}</div>
        <div class="post-bar" style={`background: ${tagColor}`}></div>

        <h1 class="post-title" id="post-title">{title}</h1>

        <div class="post-meta">
          <span id="post-read">{readTime} min read</span>
          <span class="post-meta-dot">·</span>
          <span id="post-date">{dateStr}</span>
        </div>
      </header>

      <div class="prose">
        <slot />
      </div>

      <a href="/" class="post-back" id="post-back">← Back</a>
    </article>
  </main>

  <Footer />
</Layout>

<script is:inline>
  (function () {
    function initCopyButtons() {
      document.querySelectorAll('.prose pre').forEach(function (pre) {
        if (pre.querySelector('.copy-btn')) return;
        var btn = document.createElement('button');
        btn.className = 'copy-btn';
        btn.textContent = 'Copy';
        btn.setAttribute('aria-label', 'Copy code');
        btn.addEventListener('click', function () {
          var code = pre.querySelector('code');
          var text = code ? code.textContent : pre.textContent;
          navigator.clipboard.writeText(text || '').then(function () {
            btn.textContent = 'Copied ✓';
            btn.classList.add('copied');
            setTimeout(function () {
              btn.textContent = 'Copy';
              btn.classList.remove('copied');
            }, 1500);
          });
        });
        pre.appendChild(btn);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCopyButtons);
    } else {
      initCopyButtons();
    }
  })();
</script>

<style>
  .post-main {
    max-width: 680px;
    margin: 0 auto;
    padding: 48px 24px 96px;
  }

  .post-article {
    width: 100%;
  }

  .post-header {
    margin-bottom: 40px;
  }

  .post-tag {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .post-bar {
    width: 28px;
    height: 2.5px;
    border-radius: 2px;
    margin-bottom: 20px;
  }

  .post-title {
    font-family: var(--font-display);
    font-size: 36px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--deep);
    margin-bottom: 16px;
  }

  .post-title:lang(zh) {
    font-family: var(--font-cn-display);
    font-size: 30px;
    letter-spacing: 0;
  }

  .post-meta {
    font-size: 13px;
    color: var(--dim);
    display: flex;
    gap: 6px;
    align-items: center;
  }

  .post-meta-dot {
    color: var(--sand);
  }

  .post-back {
    display: inline-block;
    margin-top: 64px;
    font-size: 13px;
    color: var(--warm-gray);
    text-decoration: none;
    transition: color 150ms;
  }

  .post-back:hover {
    color: var(--deep);
  }

  @media (max-width: 768px) {
    .post-main {
      padding: 32px 20px 64px;
    }
    .post-title {
      font-size: 28px;
    }
  }
</style>
