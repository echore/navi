---
import Layout from './Layout.astro';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  titleEn?: string;
  titleZh?: string;
  lang: 'en' | 'zh';
  /** Post body contains both .lang-en and .lang-zh, and this page may switch. */
  bilingual?: boolean;
  tags: string[];
  date: Date;
  readTime: number;
  series?: string;
  wide?: boolean;
  /** Wide pages with their own hero hide this title. The overview keeps it. */
  showTitle?: boolean;
}

const { title, titleEn, titleZh, lang, bilingual = false, tags, date, readTime, series, wide = false, showTitle = false } = Astro.props;
const hideChrome = wide && !showTitle;

const dateStr = date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
const primaryTag = tags[0] ?? 'Notes';
const tagColor = primaryTag === 'AI' ? 'var(--terra)' : 'var(--sage)';
const showToggle = Boolean(bilingual && titleEn && titleZh);
const pageLang = showToggle ? 'en' : lang;
const pageTitle = showToggle ? titleEn! : title;
---

<Layout title={`${pageTitle} — Stay Curious`} description={pageTitle} lang={pageLang}>
  <NavBar />

  <main class:list={['post-main', { wide }]}>
    <article class="post-article" id="post-article" lang={showToggle ? 'en' : undefined}>
      <header class:list={['post-header', { 'wide-header': hideChrome }]}>
        <div class="post-tag" style={`color: ${tagColor}`}>{primaryTag}</div>
        <div class="post-bar" style={`background: ${tagColor}`}></div>

        <h1 class="post-title" id="post-title">
          {showToggle ? (
            <>
              <span class="lang-en">{titleEn}</span>
              <span class="lang-zh">{titleZh}</span>
            </>
          ) : title}
        </h1>
        {series && <p class="post-series">{series}</p>}

        <div class="post-meta">
          <span id="post-read">{readTime} min read</span>
          <span class="post-meta-dot">·</span>
          <span id="post-date">{dateStr}</span>
          {showToggle && (
            <div class="post-lang" id="post-lang" role="group" aria-label="Language">
              <button type="button" class="post-lang-btn active" data-lang="en" aria-pressed="true">EN</button>
              <button type="button" class="post-lang-btn" data-lang="zh" aria-pressed="false">中文</button>
            </div>
          )}
        </div>
      </header>

      <div class={wide ? 'overview-body' : 'prose'}>
        <slot />
      </div>

      <a href="/" class="post-back" id="post-back">← Back</a>
    </article>
  </main>

  <Footer />
</Layout>

<script is:inline>
  (function () {
    function initCopyButtons() {
      document.querySelectorAll('.prose pre').forEach(function (pre) {
        if (pre.querySelector('.copy-btn')) return;
        var btn = document.createElement('button');
        btn.className = 'copy-btn';
        btn.textContent = 'Copy';
        btn.setAttribute('aria-label', 'Copy code');
        btn.addEventListener('click', function () {
          var code = pre.querySelector('code');
          var text = code ? code.textContent : pre.textContent;
          navigator.clipboard.writeText(text || '').then(function () {
            btn.textContent = 'Copied ✓';
            btn.classList.add('copied');
            setTimeout(function () {
              btn.textContent = 'Copy';
              btn.classList.remove('copied');
            }, 1500);
          });
        });
        pre.appendChild(btn);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCopyButtons);
    } else {
      initCopyButtons();
    }
  })();
</script>

<script is:inline>
  (function () {
    var root = document.getElementById('post-article');
    var group = document.getElementById('post-lang');
    if (!root || !group) return;

    function apply(lang) {
      root.setAttribute('lang', lang);
      document.documentElement.lang = lang;
      group.querySelectorAll('.post-lang-btn').forEach(function (btn) {
        var on = btn.getAttribute('data-lang') === lang;
        btn.classList.toggle('active', on);
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      var titleEl = document.getElementById('post-title');
      var shown = titleEl && titleEl.querySelector('.lang-' + lang);
      if (shown && shown.textContent) {
        document.title = shown.textContent + ' — Stay Curious';
      }
    }

    group.addEventListener('click', function (e) {
      var btn = e.target && e.target.closest ? e.target.closest('.post-lang-btn') : null;
      if (!btn) return;
      apply(btn.getAttribute('data-lang') || 'en');
    });
  })();
</script>

<style>
  .post-main {
    max-width: 680px;
    margin: 0 auto;
    padding: 48px 24px 96px;
  }

  .post-article {
    width: 100%;
  }

  .post-header {
    margin-bottom: 40px;
  }

  .post-tag {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .post-bar {
    width: 28px;
    height: 2.5px;
    border-radius: 2px;
    margin-bottom: 20px;
  }

  .post-title {
    font-family: var(--font-display);
    font-size: 36px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--deep);
    margin-bottom: 16px;
  }

  .post-title:lang(zh) {
    font-family: var(--font-cn-display);
    font-size: 30px;
    letter-spacing: 0;
  }

  .post-series {
    margin: -6px 0 14px;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--terra);
  }

  .post-meta {
    font-size: 13px;
    color: var(--dim);
    display: flex;
    gap: 6px;
    align-items: center;
    flex-wrap: wrap;
  }

  .post-lang {
    display: inline-flex;
    align-items: center;
    margin-left: auto;
    background: rgba(44, 40, 32, 0.07);
    border-radius: 999px;
    padding: 2px;
    gap: 1px;
  }

  .post-lang-btn {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.03em;
    padding: 3px 9px;
    border-radius: 999px;
    border: none;
    cursor: pointer;
    background: transparent;
    color: var(--warm-gray);
  }

  .post-lang-btn.active {
    background: var(--deep);
    color: var(--canvas);
  }

  .post-meta-dot {
    color: var(--sand);
  }

  .post-back {
    display: inline-block;
    margin-top: 64px;
    font-size: 13px;
    color: var(--warm-gray);
    text-decoration: none;
    transition: color 150ms;
  }

  .post-back:hover {
    color: var(--deep);
  }

  .post-main.wide {
    max-width: 1240px;
    padding-top: 28px;
  }

  .post-main.wide .post-header:not(.wide-header) {
    max-width: 720px;
  }

  .wide-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 8px;
  }

  .wide-header .post-tag,
  .wide-header .post-bar,
  .wide-header .post-title,
  .wide-header #post-read,
  .wide-header #post-date,
  .wide-header .post-meta-dot {
    display: none;
  }

  .wide-header .post-series {
    margin: 0;
  }

  .wide-header .post-meta {
    margin-left: auto;
  }

  @media (max-width: 768px) {
    .post-main {
      padding: 32px 20px 64px;
    }
    .post-title {
      font-size: 28px;
    }
  }
</style>
